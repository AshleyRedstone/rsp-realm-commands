            <termEntry id="refers to a noise that is played when a player's name is said in chat, could be translated as 'notification' if no equivalent word exists">
                <langSet xml:lang="en"><tig><term>Ping</term></tig></langSet>
                <langSet xml:lang="tok"><tig><term></term></tig></langSet>
            </termEntry>
        </body>
    </text>
